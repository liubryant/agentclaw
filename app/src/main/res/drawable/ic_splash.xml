<?xml version="1.0" encoding="utf-8"?>
<!--
  Dedicated splash icon for Android 12+ SplashScreen.

  Note: Android 12 system SplashScreen will always apply a system mask to the icon
  (typically a circle). To make it look like a normal rounded-corner app icon,
  we draw a rounded-rect background and inset the foreground inside it.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="@color/white" />
        </shape>
    </item>

    <item
        android:drawable="@mipmap/ic_launcher_foreground"
        android:top="10dp"
        android:bottom="10dp"
        android:left="10dp"
        android:right="10dp" />

</layer-list>
