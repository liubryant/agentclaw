<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="4dp"
    android:background="@drawable/bg_shell_session_item"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:maxHeight="45dp"
    android:orientation="horizontal"
    android:paddingStart="2dp"
    android:paddingTop="4dp"
    android:paddingEnd="4dp"
    android:paddingBottom="8dp">


    <ImageView
        android:id="@+id/messageIcon"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_marginStart="2dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_message_selector" />

    <TextView
        android:id="@+id/titleView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="@font/misans_medium"
        android:maxLines="1"
        android:textColor="@color/text_primary"
        android:textSize="11sp" />

    <ImageButton
        android:id="@+id/actionButton"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_marginStart="4dp"
        android:background="@drawable/bg_shell_delete_button"
        android:contentDescription="@string/chat_delete_confirm"
        android:padding="0dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_shell_delete"
        android:visibility="invisible" />
</LinearLayout>
