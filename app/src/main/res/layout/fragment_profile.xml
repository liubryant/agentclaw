<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFDFD"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/misans_demibold"
            android:text="@string/profile_title"
            android:textColor="#15151A"
            android:textSize="27sp" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/loginCard"
            android:layout_width="match_parent"
            android:layout_height="116dp"
            android:layout_marginTop="18dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="#EEE7FF"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeColor="#286750F5"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="18dp">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/bg_profile_avatar"
                    android:contentDescription="@null"
                    android:padding="13dp"
                    android:src="@drawable/ic_bottom_profile"
                    android:tint="#FFFFFF" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/profileName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/misans_demibold"
                        android:textColor="#19191F"
                        android:textSize="19sp" />

                    <TextView
                        android:id="@+id/profileSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:fontFamily="@font/misans_normal"
                        android:textColor="#73727E"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/loginAction"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_profile_login_action"
                    android:gravity="center"
                    android:minWidth="72dp"
                    android:paddingHorizontal="16dp"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:id="@+id/vipCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_profile_vip_card"
            android:clickable="true"
            android:elevation="2dp"
            android:focusable="true"
            android:minHeight="102dp"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="9dp"
            android:paddingBottom="7dp">

            <!-- Top row: icon + title/subtitle + action button -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_profile_vip_icon"
                    android:gravity="center"
                    android:text="✦"
                    android:textColor="#4B2A12"
                    android:textSize="18sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="11dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/misans_demibold"
                        android:maxLines="2"
                        android:text="@string/profile_vip_title"
                        android:textColor="#FFF2D2"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/vipSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:maxLines="2"
                        android:textColor="#C8A97E"
                        android:textSize="10sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:background="@drawable/bg_profile_vip_action"
                    android:gravity="center"
                    android:maxLines="1"
                    android:minWidth="82dp"
                    android:paddingHorizontal="12dp"
                    android:text="@string/profile_vip_action"
                    android:textColor="#4F2D16"
                    android:textSize="11sp"
                    android:fontFamily="@font/misans_demibold" />
            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="6dp"
                android:background="#22FFFFFF" />

            <!-- Benefits row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="✦ AI 图像生成"
                    android:textColor="#EECC9A"
                    android:textSize="10sp" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="12dp"
                    android:background="#33FFFFFF" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="✦ AI 视频生成"
                    android:textColor="#EECC9A"
                    android:textSize="10sp" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="12dp"
                    android:background="#33FFFFFF" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="✦ 无限对话"
                    android:textColor="#EECC9A"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="9dp"
            android:fontFamily="@font/misans_demibold"
            android:text="@string/profile_services"
            android:textColor="#202027"
            android:textSize="17sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_profile_section"
            android:orientation="vertical">

            <include android:id="@+id/documentsRow" layout="@layout/item_profile_entry_documents" />
            <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="54dp" android:background="#0F000000" />
            <include android:id="@+id/settingsRow" layout="@layout/item_profile_entry_settings" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="9dp"
            android:fontFamily="@font/misans_demibold"
            android:text="@string/profile_about"
            android:textColor="#202027"
            android:textSize="17sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_profile_section"
            android:orientation="vertical">

            <include android:id="@+id/userAgreementRow" layout="@layout/item_profile_entry_agreement" />
            <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="54dp" android:background="#0F000000" />
            <include android:id="@+id/privacyPolicyRow" layout="@layout/item_profile_entry_privacy" />
            <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="54dp" android:background="#0F000000" />
            <include android:id="@+id/feedbackRow" layout="@layout/item_profile_entry_feedback" />
            <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="54dp" android:background="#0F000000" />
            <include android:id="@+id/ratingRow" layout="@layout/item_profile_entry_rating" />
            <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="54dp" android:background="#0F000000" />
            <include android:id="@+id/deleteAccountRow" layout="@layout/item_profile_entry_delete_account" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/accountActionsCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_profile_section"
            android:orientation="vertical">

            <include
                android:id="@+id/logoutRow"
                layout="@layout/item_profile_entry_logout" />
        </LinearLayout>

        <TextView
            android:id="@+id/versionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:textColor="#A0A0AA"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
