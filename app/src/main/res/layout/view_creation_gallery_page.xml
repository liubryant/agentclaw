<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="16dp"
    android:paddingEnd="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="104dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/primaryFeatureCard"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_creation_feature_primary"
            android:clickable="true"
            android:elevation="1dp"
            android:focusable="true"
            android:gravity="bottom"
            android:orientation="vertical"
            android:padding="14dp">

            <ImageView
                android:id="@+id/primaryFeatureIcon"
                android:layout_width="27dp"
                android:layout_height="27dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_creation_spark" />

            <TextView
                android:id="@+id/primaryFeatureTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:fontFamily="@font/misans_demibold"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/primaryFeatureHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="@font/misans_normal"
                android:maxLines="1"
                android:textColor="#DFFFFFFF"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/secondaryFeatureCard"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_creation_feature_secondary"
            android:clickable="true"
            android:elevation="1dp"
            android:focusable="true"
            android:gravity="bottom"
            android:orientation="vertical"
            android:padding="14dp">

            <ImageView
                android:id="@+id/secondaryFeatureIcon"
                android:layout_width="27dp"
                android:layout_height="27dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_creation_layers" />

            <TextView
                android:id="@+id/secondaryFeatureTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:fontFamily="@font/misans_demibold"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/secondaryFeatureHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="@font/misans_normal"
                android:maxLines="1"
                android:textColor="#DFFFFFFF"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="10dp"
        android:fontFamily="@font/misans_demibold"
        android:text="@string/creation_inspiration"
        android:textColor="#1C1C22"
        android:textSize="18sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/mediaRecycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingBottom="20dp" />
</LinearLayout>
