<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#99000000"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:id="@+id/loginDialogContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginHorizontal="15dp"
        android:background="@drawable/bg_setting_dialog"
        android:clickable="true"
        android:elevation="18dp"
        android:focusable="true"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="24dp"
        android:paddingEnd="28dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/misans_medium"
                    android:text="@string/login_title"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/misans_medium"
                    android:text="@string/login_dialog_subtitle"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/loginCloseButton"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_chat_icon_button"
                android:contentDescription="@string/common_close"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_search_close"
                app:tint="@color/black" />
        </LinearLayout>

        <EditText
            android:id="@+id/loginPhoneInput"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_login_field"
            android:fontFamily="@font/misans_medium"
            android:hint="@string/login_phone_hint"
            android:importantForAutofill="yes"
            android:inputType="phone"
            android:maxLines="1"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/sidebar_muted"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/loginPhoneError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/misans_medium"
            android:text="@string/login_phone_invalid"
            android:textColor="@color/error"
            android:textSize="12sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/loginPasswordRow"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_login_field"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/loginPasswordInput"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:fontFamily="@font/misans_medium"
                android:hint="@string/login_password_hint"
                android:importantForAutofill="yes"
                android:inputType="textPassword"
                android:maxLines="1"
                android:paddingStart="14dp"
                android:paddingEnd="8dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/sidebar_muted"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/loginCodeButton"
                android:layout_width="72dp"
                android:layout_height="34dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_login_code_button"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/misans_medium"
                android:gravity="center"
                android:text="@string/login_code"
                android:textColor="@color/brand_primary"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/loginPasswordError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/misans_medium"
            android:text="@string/login_password_empty"
            android:textColor="@color/error"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/loginSubmitButton"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_login_primary_button"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/misans_medium"
            android:gravity="center"
            android:text="@string/login_submit"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
