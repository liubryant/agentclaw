<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/shellChatRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    >

    <TextView
        android:id="@+id/connectionView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_card_surface"
        android:padding="12dp"
        android:textColor="@color/text_secondary"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/errorCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_card_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/connectionView">

        <TextView
            android:id="@+id/errorView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/error" />

        <Button
            android:id="@+id/dismissErrorButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/chat_dismiss" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/loadingBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:indeterminate="true"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/errorCard" />

    <FrameLayout
        android:id="@+id/contentContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/thinkingIndicator"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/loadingBar">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/messagesRecycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:visibility="gone" />

        <ScrollView
            android:id="@+id/emptyStateScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:overScrollMode="never">

            <LinearLayout
                android:id="@+id/welcomeGroup"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="20dp"
                android:paddingBottom="12dp">

                <ImageView
                    android:id="@+id/lobsterView"
                    android:layout_width="33dp"
                    android:layout_height="33dp"
                    android:adjustViewBounds="true"
                    android:contentDescription="@null"
                    android:src="@mipmap/ic_launcher" />

                <TextView
                    android:id="@+id/welcomeTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:fontFamily="@font/misans_medium"
                    android:text="@string/chat_empty_brand"
                    android:textColor="#333333"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/welcomeSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="25dp"
                    android:gravity="center"
                    android:text="@string/chat_empty_subtitle"
                    android:textColor="@color/gray"
                    android:textSize="12sp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/quickPromptRecycler"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="30dp"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="12dp" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/thinkingIndicator"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="10dp"
        android:paddingBottom="6dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/exportSessionFilesButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ProgressBar
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:indeterminate="true" />

        <TextView
            android:id="@+id/thinkingLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/chat_thinking"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/exportSessionFilesButton"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:drawableStart="@drawable/ic_download_28_wrapper"
        android:drawablePadding="4px"
        android:gravity="center_vertical"
        android:paddingEnd="16dp"
        android:text="@string/chat_click_to_download_file"
        android:textColor="#3978F3"
        android:textSize="13sp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/composerCard"
        app:layout_constraintStart_toStartOf="parent" />

    <LinearLayout
        android:id="@+id/composerCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/chatEntryButtonsRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/imageChatEntryButton"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_chat_entry_button"
                    android:clickable="true"
                    android:drawablePadding="4dp"
                    android:drawableStart="@drawable/ic_chat_entry_image"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/chat_entry_image"
                    android:textColor="#111111"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/videoChatEntryButton"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_chat_entry_button"
                    android:clickable="true"
                    android:drawablePadding="4dp"
                    android:drawableStart="@drawable/ic_chat_entry_video"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/chat_entry_video"
                    android:textColor="#111111"
                    android:textSize="11sp" />
            </LinearLayout>
        </HorizontalScrollView>

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chat_composer_shadow"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/composerInner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:background="@drawable/bg_chat_entry_button"
            android:minHeight="90dp"
            android:orientation="vertical">

            <!-- Thumbnail row: appears at top-left when an image is attached -->
            <LinearLayout
                android:id="@+id/imageThumbnailRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingTop="10dp"
                android:visibility="gone">

                <FrameLayout
                    android:id="@+id/imageThumbnailContainer"
                    android:layout_width="96dp"
                    android:layout_height="96dp">

                    <ImageView
                        android:id="@+id/imageThumbnail"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:background="@drawable/bg_chat_entry_button"
                        android:clipToOutline="true"
                        android:contentDescription="已选图片" />

                    <ImageButton
                        android:id="@+id/removeThumbnailButton"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="top|end"
                        android:layout_margin="-2dp"
                        android:background="@android:color/transparent"
                        android:padding="0dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_thumbnail_remove"
                        android:contentDescription="删除图片" />
                </FrameLayout>
            </LinearLayout>

            <!-- Input row: EditText full-width, buttons overlay at bottom-right -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dp">

                <EditText
                    android:id="@+id/composerInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:background="@android:color/transparent"
                    android:fontFamily="@font/misans_medium"
                    android:gravity="top|start"
                    android:hint="@string/chat_shell_input_hint"
                    android:importantForAutofill="no"
                    android:includeFontPadding="false"
                    android:inputType="textCapSentences|textMultiLine"
                    android:lineSpacingExtra="0dp"
                    android:maxLines="4"
                    android:minHeight="120dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="58dp"
                    android:textColor="@color/black"
                    android:textColorHint="#A6A6A6"
                    android:textCursorDrawable="@null"
                    android:textSize="15sp"
                    tools:text="今天天气怎么样？后天天气怎么样？大后天天气怎么样？昨天天气怎么样？大前天天气怎么样？大大大后天怎么样？明天天气怎么样？" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="58dp"
                    android:layout_gravity="bottom|end"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/attachButton"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:background="@android:color/transparent"
                        android:contentDescription="添加图片"
                        android:padding="0dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_composer_attach" />

                    <FrameLayout
                        android:id="@+id/sendControls"
                        android:layout_width="52dp"
                        android:layout_height="52dp">

                        <ImageButton
                            android:id="@+id/sendButton"
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:background="@android:color/transparent"
                            android:contentDescription="@string/chat_send"
                            android:paddingStart="10dp"
                            android:paddingTop="8dp"
                            android:paddingEnd="4dp"
                            android:paddingBottom="8dp"
                            app:tint="@color/black"
                            android:scaleType="fitEnd"
                            android:src="@drawable/ic_chat_send" />

                        <ImageButton
                            android:id="@+id/stopButton"
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:background="@android:color/transparent"
                            android:contentDescription="@string/chat_stop"
                            android:paddingStart="10dp"
                            android:paddingTop="8dp"
                            android:paddingEnd="4dp"
                            android:paddingBottom="8dp"
                            android:scaleType="fitEnd"
                            android:src="@drawable/ic_chat_stop"
                            android:visibility="gone" />
                    </FrameLayout>
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/disclaimerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="4dp"
            android:gravity="center"
            android:text="@string/chat_disclaimer_cn"
            android:textColor="#3D000000"
            android:textSize="10sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
