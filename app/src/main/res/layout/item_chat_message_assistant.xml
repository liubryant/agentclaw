<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="0dp"
    android:paddingBottom="0dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:layout_marginEnd="0dp"
        android:background="@drawable/bg_chat_message_assistant"
        android:gravity="top"
        android:orientation="horizontal">

<!--        <FrameLayout-->
<!--            android:layout_width="12dp"-->
<!--            android:layout_height="match_parent"-->
<!--            android:layout_marginTop="18dp"-->
<!--            android:layout_marginBottom="18dp">-->

<!--            <View-->
<!--                android:layout_width="2dp"-->
<!--                android:layout_height="match_parent"-->
<!--                android:layout_gravity="center_horizontal"-->
<!--                android:background="#EBEBEB" />-->
<!--        </FrameLayout>-->

        <LinearLayout
            android:id="@+id/bubbleContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/messageView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/misans_normal"
                android:includeFontPadding="false"
                android:lineSpacingExtra="18sp"
                android:linksClickable="true"
                android:textColor="@color/black"
                android:textIsSelectable="false"
                android:textSize="12sp" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/generatedImageCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:visibility="gone"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <ImageView
                    android:id="@+id/generatedImageView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:background="#0F000000"
                    android:contentDescription="@string/chat_generated_image"
                    android:maxHeight="360dp"
                    android:scaleType="fitCenter" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/generatedImageStatusView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/misans_normal"
                android:text="@string/chat_image_loading"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:visibility="gone" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/generatedVideoCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:visibility="gone"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <FrameLayout
                    android:id="@+id/generatedVideoContainer"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:minHeight="120dp"
                    android:background="#0F000000">

                    <ImageView
                        android:id="@+id/generatedVideoCoverView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="fitCenter"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/generatedVideoPlayButton"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_video_play_button"
                        android:gravity="center"
                        android:text="▶"
                        android:textColor="@android:color/white"
                        android:textSize="24sp"
                        android:visibility="gone" />

                    <ProgressBar
                        android:id="@+id/generatedVideoProgressBar"
                        style="?android:attr/progressBarStyleLarge"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="center"
                        android:indeterminate="true"
                        android:visibility="gone" />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/generatedVideoStatusView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/misans_normal"
                android:text="@string/chat_video_loading"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/streamingView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/misans_normal"
                android:text="@string/chat_streaming"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
