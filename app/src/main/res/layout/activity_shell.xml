<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/shellRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_shell_external"
    android:orientation="horizontal">

    <LinearLayout
        android:id="@+id/sidebarContainer"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.2"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingRight="8dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/sidebarSearchInput"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:background="@drawable/bg_shell_search_field"
            android:clickable="true"
            android:drawableStart="@drawable/ic_shell_search_small"
            android:drawablePadding="4dp"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:fontFamily="@font/misans_medium"
            android:gravity="center_vertical"
            android:hint="@string/shell_search_hint"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/sidebar_muted"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/newChatButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_shell_session_item"
            android:clickable="true"
            android:drawableStart="@drawable/ic_new_chat"
            android:drawablePadding="8dp"
            android:focusable="true"
            android:fontFamily="@font/misans_medium"
            android:gravity="center_vertical"
            android:maxHeight="45dp"
            android:layout_marginTop="4dp"
            android:minHeight="37dp"
            android:paddingStart="14dp"
            android:paddingTop="4dp"
            android:paddingEnd="4dp"
            android:text="@string/chat_new"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="visible" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:visibility="gone"
            android:fontFamily="@font/misans_medium"
            android:text="@string/chat_sessions"
            android:textColor="@color/sidebar_muted"
            android:textSize="12sp"
            android:textStyle="bold" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/sidebarSessionsRecycler"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="16dp" />

            <LinearLayout
                android:id="@+id/sidebarEmptyView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_shell_empty_history" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/misans_medium"
                    android:gravity="center"
                    android:text="@string/shell_session_empty"
                    android:textColor="@color/sidebar_muted"
                    android:textSize="10sp" />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="vertical">

            <ai.cjym.agentclaw.ui.widget.SidebarNavItemView
                android:id="@+id/navIdeas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:navIcon="@drawable/ic_shell_ideas"
                app:navIconTint="@color/black"
                app:navText="@string/ideas_title"
                app:navSubtitle="@string/nav_ideas_subtitle" />

            <ai.cjym.agentclaw.ui.widget.SidebarNavItemView
                android:id="@+id/navAgentclawDocs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:navIcon="@drawable/ic_shell_file"
                app:navIconTint="@color/black"
                app:navText="@string/agentclaw_docs_title"
                app:navSubtitle="@string/agentclaw_docs_subtitle" />

            <ai.cjym.agentclaw.ui.widget.SidebarNavItemView
                android:id="@+id/navLogin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:navIcon="@drawable/ic_shell_login"
                app:navIconTint="@color/black"
                app:navText="@string/login_title"
                app:navSubtitle="@string/nav_login_subtitle" />

<!--            <ai.cjym.agentclaw.ui.widget.SidebarNavItemView-->
<!--                android:id="@+id/navSchedule"-->
<!--                android:layout_width="match_parent"-->
<!--                android:layout_height="wrap_content"-->
<!--                android:layout_marginTop="12dp"-->
<!--                app:navIcon="@drawable/ic_shell_clock"-->
<!--                app:navText="@string/schedule_title" />-->

            <ai.cjym.agentclaw.ui.widget.SidebarNavItemView
                android:id="@+id/navSetting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:navIcon="@drawable/ic_shell_setting"
                app:navIconTint="@color/black"
                app:navText="@string/settings_title"
                app:navSubtitle="@string/nav_settings_subtitle" />

            <LinearLayout
                android:id="@+id/navVipMembership"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_sidebar_vip_entry"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/misans_medium"
                    android:text="✦  VIP 会员"
                    android:textColor="#F5D69D"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:fontFamily="@font/misans_medium"
                    android:gravity="center"
                    android:text="解锁满血 AI"
                    android:textColor="#C9AA79"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>


    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="2.5"
        android:layout_margin="3dp">

        <LinearLayout
            android:clipToOutline="true"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_chat_screen_surface"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/chatHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="18dp"
                android:layout_marginVertical="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/sidebarButton"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:padding="4dp"
                    android:background="@drawable/bg_chat_icon_button"
                    android:contentDescription="@string/shell_open_sidebar"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_chat_sidebar"
                    app:tint="@color/black" />

                <ImageButton
                    android:id="@+id/newConversationButton"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:padding="5dp"
                    android:background="@drawable/bg_chat_icon_button"
                    android:contentDescription="@string/chat_new"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_plus_bubble"
                    app:tint="@color/black" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <ImageButton
                    android:id="@+id/headerSettingButton"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_chat_icon_button"
                    android:contentDescription="@string/settings_title"
                    android:padding="4dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_shell_setting"
                    app:tint="@color/black" />

                <LinearLayout
                    android:id="@+id/usageChip"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="14dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_chat_data"
                        app:tint="@color/gray" />

                    <TextView
                        android:id="@+id/usageText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/chat_usage_hint"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/stroke_soft" />

            <androidx.fragment.app.FragmentContainerView
                android:id="@+id/shellFragmentContainer"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#0F111827" />

            <LinearLayout
                android:id="@+id/bottomNavigationBar"
                android:layout_width="match_parent"
                android:layout_height="68dp"
                android:background="#FCFFFFFF"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingTop="7dp"
                android:paddingEnd="12dp"
                android:paddingBottom="7dp">

                <LinearLayout
                    android:id="@+id/bottomCreationTab"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_creation_bottom_item"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/bottomCreationIcon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_bottom_creation_selector"
                        android:tint="@color/creation_bottom_item_color" />

                    <TextView
                        android:id="@+id/bottomCreationText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:fontFamily="@font/misans_demibold"
                        android:text="@string/bottom_creation"
                        android:textColor="@color/creation_bottom_item_color"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/bottomConversationTab"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_creation_bottom_item"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/bottomConversationIcon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_bottom_conversation_selector"
                        android:tint="@color/creation_bottom_item_color" />

                    <TextView
                        android:id="@+id/bottomConversationText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:fontFamily="@font/misans_demibold"
                        android:text="@string/bottom_conversation"
                        android:textColor="@color/creation_bottom_item_color"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/bottomProfileTab"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_creation_bottom_item"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/bottomProfileIcon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_bottom_profile_selector"
                        android:tint="@color/creation_bottom_item_color" />

                    <TextView
                        android:id="@+id/bottomProfileText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:fontFamily="@font/misans_demibold"
                        android:text="@string/bottom_profile"
                        android:textColor="@color/creation_bottom_item_color"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

<!--            <LinearLayout-->
<!--                android:layout_width="match_parent"-->
<!--                android:layout_height="wrap_content"-->
<!--                android:gravity="end|center_vertical"-->
<!--                android:orientation="horizontal"-->
<!--                android:paddingStart="18dp"-->
<!--                android:paddingEnd="18dp"-->
<!--                android:paddingBottom="10dp" />-->
        </LinearLayout>

        <LinearLayout
            android:id="@+id/shellTopNotice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_shell_top_notice"
            android:elevation="18dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingTop="10dp"
            android:paddingEnd="20dp"
            android:paddingBottom="10dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_shell_notice_warning" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:fontFamily="@font/misans_medium"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/shell_top_notice_no_network"
                android:textColor="@color/black"
                android:textSize="16sp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
